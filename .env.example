# RetroTape configuration — copy to .env and adjust.
# These are read by docker-compose (and by `npm start` locally).

# Internal + published port the server listens on.
PORT=3000

# Public address of this deployment (used to display shareable library links).
# Example: https://tapes.com
BASE_URL=http://localhost:3000

# In-container path where the SQLite DB + sessions are persisted.
# Mounted from the `retrotape_data` volume.
DATA_DIR=/data

# In-container path where uploaded video media is stored (kept inside the
# container tree). Mounted from the `retrotape_media` volume.
UPLOADS_DIR=/app/uploads

# Secret used to sign session cookies. Set this to a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: maximum upload size in bytes (default 4 GiB).
# MAX_UPLOAD_BYTES=4294967296
