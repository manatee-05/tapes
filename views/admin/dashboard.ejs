<%- include('../partials/head', { pageTitle: 'RetroTape — Admin Dashboard' }) %>

<main class="max-w-5xl mx-auto p-4 sm:p-8">

  <!-- Top bar -->
  <header class="vcr-panel flex flex-wrap items-center justify-between gap-3 mb-8">
    <div class="flex items-center gap-3">
      <span class="led on"></span>
      <h1 class="retro-title text-base sm:text-lg text-amber-glow">RETROTAPE ADMIN</h1>
    </div>
    <div class="flex items-center gap-3 font-mono text-sm">
      <span class="opacity-70">operator: <span class="text-phosphor-glow"><%= username %></span></span>
      <form method="POST" action="/admin/logout"><button class="vcr-btn text-xs">⏏ LOGOUT</button></form>
    </div>
  </header>

  <% if (notice) { %><div class="notice ok"><%= notice %></div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>

  <div class="grid md:grid-cols-2 gap-8">

    <!-- ============ Create a new library ============ -->
    <section class="terminal p-6">
      <h2 class="retro-title text-sm mb-4 text-phosphor-glow">// NEW LIBRARY</h2>
      <form method="POST" action="/admin/libraries" class="space-y-4">
        <label class="block">
          <span class="font-mono text-sm">TITLE</span>
          <input class="mt-1" type="text" name="title" required placeholder="Joe's Home Movies" />
        </label>
        <label class="block">
          <span class="font-mono text-sm">URL SLUG</span>
          <div class="flex items-center gap-1 mt-1">
            <span class="font-mono text-xs opacity-60 whitespace-nowrap"><%= BASE_URL %>/</span>
            <input type="text" name="slug" placeholder="joe" pattern="[a-z0-9-]+" />
          </div>
        </label>
        <label class="block">
          <span class="font-mono text-sm">PASSCODE <span class="opacity-50">(optional, alphanumeric)</span></span>
          <input class="mt-1" type="text" name="passcode" maxlength="32" placeholder="leave blank for open access" />
        </label>
        <button type="submit" class="vcr-btn w-full">＋ CREATE LIBRARY</button>
      </form>
    </section>

    <!-- ============ Existing libraries ============ -->
    <section class="terminal p-6">
      <h2 class="retro-title text-sm mb-4 text-phosphor-glow">// LIBRARIES</h2>
      <% if (libraries.length === 0) { %>
        <p class="font-mono text-sm opacity-60">No libraries yet. Create one to start filling shelves.</p>
      <% } else { %>
        <ul class="space-y-3">
          <% libraries.forEach(function(lib){ %>
            <li class="border border-gray-800 rounded p-3">
              <div class="flex items-center justify-between gap-2">
                <div>
                  <div class="font-mono text-amber-glow"><%= lib.title %></div>
                  <a class="font-mono text-xs underline opacity-70" href="/<%= lib.slug %>" target="_blank"><%= BASE_URL %>/<%= lib.slug %></a>
                  <div class="text-xs opacity-60 mt-1">
                    <%= lib.videoCount %> tape(s) ·
                    <% if (lib.secured) { %><span class="text-amber-glow">🔒 secured</span><% } else { %><span class="text-phosphor-glow">open</span><% } %>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <a class="vcr-btn text-xs" href="/admin?library=<%= lib.id %>">MANAGE</a>
                  <form method="POST" action="/admin/libraries/<%= lib.id %>/delete"
                        onsubmit="return confirm('Erase library &quot;<%= lib.title %>&quot; and ALL its tapes? This cannot be undone.');">
                    <button class="vcr-btn eject text-xs w-full">⏏ DELETE</button>
                  </form>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </div>

  <!-- ============ Manage selected library ============ -->
  <% if (selected) { %>
    <section class="terminal p-6 mt-8">
      <h2 class="retro-title text-sm mb-1 text-amber-glow">// MANAGING: <%= selected.title %></h2>
      <p class="font-mono text-xs opacity-60 mb-6"><%= BASE_URL %>/<%= selected.slug %></p>

      <div class="grid md:grid-cols-2 gap-8">

        <!-- Edit settings -->
        <div>
          <h3 class="font-mono text-phosphor-glow mb-3">SETTINGS</h3>
          <form method="POST" action="/admin/libraries/<%= selected.id %>" class="space-y-4">
            <label class="block">
              <span class="font-mono text-sm">TITLE</span>
              <input class="mt-1" type="text" name="title" value="<%= selected.title %>" required />
            </label>
            <label class="block">
              <span class="font-mono text-sm">SLUG</span>
              <input class="mt-1" type="text" name="slug" value="<%= selected.slug %>" pattern="[a-z0-9-]+" required />
            </label>
            <fieldset class="border border-gray-800 rounded p-3">
              <legend class="font-mono text-xs px-1">PASSCODE</legend>
              <label class="flex items-center gap-2 font-mono text-sm">
                <input type="radio" name="passcode_action" value="keep" checked /> Keep current
                (<%= selected.passcode_hash ? 'secured 🔒' : 'open' %>)
              </label>
              <label class="flex items-center gap-2 font-mono text-sm mt-1">
                <input type="radio" name="passcode_action" value="remove" /> Remove protection
              </label>
              <label class="flex items-center gap-2 font-mono text-sm mt-1">
                <input type="radio" name="passcode_action" value="set" /> Set new:
                <input type="text" name="passcode" maxlength="32" class="!w-40" placeholder="new code" />
              </label>
            </fieldset>
            <button type="submit" class="vcr-btn w-full">💾 SAVE SETTINGS</button>
          </form>
        </div>

        <!-- Upload a tape -->
        <div>
          <h3 class="font-mono text-phosphor-glow mb-3">LOAD A NEW TAPE</h3>
          <form method="POST" action="/admin/libraries/<%= selected.id %>/videos"
                enctype="multipart/form-data" class="space-y-4">
            <label class="block">
              <span class="font-mono text-sm">VIDEO FILE</span>
              <input class="mt-1" type="file" name="video" accept="video/*" required />
            </label>
            <label class="block">
              <span class="font-mono text-sm">TAPE TITLE</span>
              <input class="mt-1" type="text" name="title" id="tapeTitle" placeholder="Summer '87" />
            </label>
            <label class="block">
              <span class="font-mono text-sm">SLEEVE NOTES (description)</span>
              <textarea class="mt-1" name="description" id="tapeDesc" rows="4"
                        placeholder="Recorded on the camcorder at the lake house..."></textarea>
            </label>

            <!-- Live "paper sleeve" preview of what the insert will look like -->
            <div>
              <span class="font-mono text-xs opacity-60">SLEEVE PREVIEW</span>
              <div class="sleeve mt-1 text-sm">
                <strong id="sleeveTitle">Untitled Tape</strong>
                <hr class="my-2 border-black/30" />
                <span id="sleeveDesc" class="opacity-80">(sleeve notes appear here)</span>
              </div>
            </div>

            <button type="submit" class="vcr-btn w-full">⏺ UPLOAD TAPE</button>
          </form>
        </div>
      </div>

      <!-- Existing tapes in this library -->
      <h3 class="font-mono text-phosphor-glow mt-8 mb-3">TAPES ON THE SHELF</h3>
      <% if (videos.length === 0) { %>
        <p class="font-mono text-sm opacity-60">No tapes yet.</p>
      <% } else { %>
        <ul class="space-y-2">
          <% videos.forEach(function(v){ %>
            <li class="flex items-center justify-between border border-gray-800 rounded p-3 gap-3">
              <div class="min-w-0">
                <div class="font-mono text-amber-glow truncate"><%= v.title %></div>
                <div class="text-xs opacity-60 truncate"><%= v.original_name %> · <%= (v.size_bytes/1048576).toFixed(1) %> MB</div>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <a class="vcr-btn text-xs" href="/<%= selected.slug %>/watch/<%= v.id %>" target="_blank">▶ PREVIEW</a>
                <form method="POST" action="/admin/videos/<%= v.id %>/delete"
                      onsubmit="return confirm('Delete tape &quot;<%= v.title %>&quot;?');">
                  <button class="vcr-btn eject text-xs">⏏ DELETE</button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  <% } %>

</main>

<script>
  // Live update of the paper-sleeve preview as the admin types.
  (function () {
    var t = document.getElementById('tapeTitle');
    var d = document.getElementById('tapeDesc');
    var st = document.getElementById('sleeveTitle');
    var sd = document.getElementById('sleeveDesc');
    if (!t || !d) return;
    function sync() {
      st.textContent = t.value.trim() || 'Untitled Tape';
      sd.textContent = d.value.trim() || '(sleeve notes appear here)';
    }
    t.addEventListener('input', sync);
    d.addEventListener('input', sync);
  })();
</script>

<%- include('../partials/foot') %>
