<%- include('../partials/head', { pageTitle: 'RetroTape — First-Time Setup' }) %>

<!-- Retro "boot sequence" setup wizard shown only when no admin exists yet. -->
<main class="min-h-screen flex items-center justify-center p-4">
  <div class="terminal w-full max-w-lg p-8">
    <pre class="text-xs leading-tight mb-4 opacity-80">
RETROTAPE BIOS v1.0
SYSTEM CHECK ........ OK
DATABASE ............ EMPTY
ADMIN ACCOUNT ....... <span class="text-amber-glow">NOT FOUND</span></pre>

    <h1 class="retro-title text-lg mb-6 text-phosphor-glow">// FIRST-TIME SETUP</h1>
    <p class="font-mono text-sm mb-6 opacity-80">
      No administrator exists. Create the master account to power on RetroTape.
    </p>

    <% if (error) { %>
      <div class="notice error"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/setup" class="space-y-4">
      <label class="block">
        <span class="font-mono text-sm">ADMIN USERNAME</span>
        <input class="mt-1" type="text" name="username" autocomplete="username"
               required minlength="3" autofocus />
      </label>
      <label class="block">
        <span class="font-mono text-sm">PASSWORD</span>
        <input class="mt-1" type="password" name="password"
               autocomplete="new-password" required minlength="6" />
      </label>
      <label class="block">
        <span class="font-mono text-sm">CONFIRM PASSWORD</span>
        <input class="mt-1" type="password" name="confirm"
               autocomplete="new-password" required minlength="6" />
      </label>
      <button type="submit" class="vcr-btn w-full mt-2">► CREATE ADMIN &amp; POWER ON</button>
    </form>
  </div>
</main>

<%- include('../partials/foot') %>
